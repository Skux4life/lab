#!/usr/bin/env bash

set -euo pipefail

usage() {
cat <<'EOF'
Usage:
  aws-profile <name>          # validate and print name
  aws-profile --list          # interactive picker
  aws-profile --current       # interactive picker
EOF
}

list_profiles() {
  printf '%s\t%s\n' "dev" "rest-workload-dev"
  printf '%s\t%s\n' "api-dev" "rest-workload-api-dev"
  printf '%s\t%s\n' "nonprod" "rest-workload-nonprod"
  printf '%s\t%s\n' "cat4r" "rest-workload-api-cat4r"
}

profile_names() {
  list_profiles | awk -F'\t' '{print $1}'
}

current_profile() {
  echo "current not yet implemented"
}


if ! command -v aws-sso >/dev/null 2>&1; then
  echo "Error: aws-sso not found in PATH" >&2
  exit 1
fi

if [[ $# == 0 ]]; then
  usage
  exit 2
fi

case "$1" in
  --list) list_profiles
    exit 0
  ;;
  --current) current_profile
    exit 0
  ;;
  *) 
    # grep note
    # -F fixed string (no regex)
    # -x match whole line only
    # -q quiet
    # -- end of options ($1 can't be treated as a flag)
    if profile_names | grep -Fxq -- "$1"; then
      printf '%s\n' "$1"
    else
      echo "aws-profile: unknown profile: $1" >&2
      exit 1
    fi
  ;;
esac

